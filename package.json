{
  "name": "grafikpro",
  "private": true,
  "version": "0.1.1",
  "description": "Lokalna aplikacja Windows do zarządzania grafikami pracy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "package:win": "npm run build && cross-env GRAFIKPRO_REQUIRE_UPDATES=true electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "publish:win": "npm run build && cross-env GRAFIKPRO_REQUIRE_UPDATES=true GRAFIKPRO_PUBLISH=true electron-builder --config electron-builder.config.cjs --win nsis --publish always",
    "package:dir": "npm run build && electron-builder --win --dir",
    "lint": "oxlint",
    "test": "vitest run src && node --test electron/database.test.cjs electron/updater.test.cjs electron/publisher.test.cjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "pl.grafikpro.desktop",
    "productName": "GrafikPro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GrafikPro"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sql.js": "^1.16.0",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
